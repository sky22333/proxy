{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "cn",
        "server": "dns.alidns.com",
        "domain_resolver": "bootstrap",
        "detour": "direct"
      },
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "rules": [
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "server": "local"
      }
    ],
    "final": "cn"
  },

  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],

  // 节点不再写死在 outbounds 里，全部来自分享链接文件，改节点只改这个 txt
  // 每行一条：vless:// hysteria2:// anytls:// tuic:// trojan:// ss:// vmess://
  "providers": [
    {
      "type": "local",
      "tag": "sub",
      "path": "/etc/sing-box/nodes.txt",
      // 文件改动会自动重载，不用重启内核
      "health_check": {
        "enabled": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "3m",
        "timeout": "3s"
      }
    }
  ],

  "outbounds": [
    {
      // 手动挡：default 写谁就固定走谁，默认交给下面的自动挡
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["auto"],
      "providers": ["sub"],
      "default": "auto",
      "interrupt_exist_connections": true
    },
    {
      // 自动挡：同一目标粘在同一节点，换节点不断其它连接
      "type": "loadbalance",
      "tag": "auto",
      "providers": ["sub"],
      "strategy": "sticky-sessions",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "idle_timeout": "30m",
      "ttl": "10m"
    },
    {
      "type": "direct",
      "tag": "direct",
      // 必须让 direct 非空：DNS 与 rule_set 的 detour 都指向它，
      // 空 direct 会被内核拒绝启动（detour to an empty direct outbound makes no sense）
      "domain_resolver": "bootstrap"
    }
  ],

  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "cn",
    "rules": [
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geoip-cn"],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "rule_set": [
      {
        "tag": "geosite-private",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      }
    ]
  },

  "experimental": {
    "cache_file": {
      "enabled": true
    }
  }
}
