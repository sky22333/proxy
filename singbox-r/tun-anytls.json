{
  "log": {
    "level": "info",
    "timestamp": true
  },

  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "bootstrap",
        "server": "223.5.5.5"
      },
      {
        "type": "https",
        "tag": "cn",
        "server": "dns.alidns.com",
        "domain_resolver": "bootstrap"
      },
      {
        "type": "local",
        "tag": "local"
      },
      {
        "type": "fakeip",
        "tag": "fakeip",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "query_type": ["AAAA"],
        "action": "predefined",
        "rcode": "NOERROR"
      },
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "server": "local"
      },
      {
        "query_type": ["A"],
        "action": "route",
        "server": "fakeip"
      }
    ],
    "final": "cn"
  },

  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30"],
      "mtu": 1500,
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],

  // 全局模式下的节点来源：改 nodes.txt 即换节点，内核自动重载
  "providers": [
    {
      "type": "local",
      "tag": "sub",
      "path": "/etc/sing-box/nodes.txt",
      "health_check": {
        "enabled": true,
        "url": "https://www.gstatic.com/generate_204",
        "interval": "3m",
        "timeout": "3s"
      }
    }
  ],

  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": ["auto"],
      "providers": ["sub"],
      "default": "auto",
      "interrupt_exist_connections": true
    },
    {
      "type": "loadbalance",
      "tag": "auto",
      "providers": ["sub"],
      "strategy": "sticky-sessions",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "idle_timeout": "30m",
      "ttl": "10m"
    },
    {
      "type": "direct",
      "tag": "direct",
      // 必须让 direct 非空：DNS 与 rule_set 的 detour 都指向它，
      // 空 direct 会被内核拒绝启动（detour to an empty direct outbound makes no sense）
      "domain_resolver": "bootstrap"
    }
  ],

  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "cn",
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-private"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-cn"],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": ["geoip-cn"],
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "rule_set": [
      {
        "tag": "geosite-private",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-private.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "update_interval": "1d",
        "http_client": {
          "detour": "direct"
        }
      }
    ]
  },

  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": true
    }
  }
}
