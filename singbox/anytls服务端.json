{
  "log": {
    "level": "info"
  },
  // 1.14 起证书统一由 certificate_provider 提供，不再内联在 tls.acme
  "certificate_providers": [
    {
      "type": "acme",
      "tag": "acme",
      "domain": [
        "example.com"
      ],
      "data_directory": "/etc/sing-box",
      "default_server_name": "example.com",
      "email": "123456789admin@gmail.com"
    }
  ],
  "inbounds": [
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 8443,
      "users": [
        {
          "name": "misaka",
          "password": "5oiR55yf5piv5pyN5LqGYeS4jeimgeS7gOS5iOmDveaKhA=="
        }
      ],
      "tls": {
        "enabled": true,
        "certificate_provider": "acme"
      }
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct-out"
    }
  ],
  "route": {
    "rules": []
  }
}
